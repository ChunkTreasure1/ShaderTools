<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MinimumVisualStudioVersion>17.14</MinimumVisualStudioVersion>
    <VSToolsPath Condition="'$(VSToolsPath)' == ''">$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)</VSToolsPath>
  </PropertyGroup>
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectTypeGuids>{82b43b9b-a64c-4715-b499-d71e9ca2bd60};{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
    <ProjectGuid>{97E7743F-61D2-4814-8404-EF451A480BB7}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>ShaderTools.VisualStudio</RootNamespace>
    <AssemblyName>ShaderTools.VisualStudio</AssemblyName>
    <LangVersion>latest</LangVersion>
    <AutoUnifyAssemblyReferences>true</AutoUnifyAssemblyReferences>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <UseCodebase>true</UseCodebase>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>false</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>true</CopyOutputSymbolsToOutputDirectory>
    <StartAction>Program</StartAction>
    <StartProgram Condition="'$(DevEnvDir)' != ''">$(DevEnvDir)devenv.exe</StartProgram>
    <StartArguments>/rootsuffix Exp</StartArguments>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Commands\ShaderCommands.cs" />
    <Compile Include="Editor\LspTextRange.cs" />
    <Compile Include="Editor\ShaderNavigableSymbolSource.cs" />
    <Compile Include="Editor\ShaderClassificationTagger.cs" />
    <Compile Include="Editor\ShaderDiagnostics.cs" />
    <Compile Include="Editor\ShaderEditorEvents.cs" />
    <Compile Include="Editor\ShaderEditorInfrastructure.cs" />
    <Compile Include="Editor\ShaderFoldingTagger.cs" />
    <Compile Include="Editor\ShaderInactiveCodeFormat.cs" />
    <Compile Include="Editor\ShaderInactiveCodeTagger.cs" />
    <Compile Include="Editor\ShaderInlayHintTagger.cs" />
    <Compile Include="ShaderToolsPackage.cs" />
    <Compile Include="LanguageClient\ShaderContentTypes.cs" />
    <Compile Include="LanguageClient\ShaderFilePathExports.cs" />
    <Compile Include="LanguageClient\ShaderLanguageClient.cs" />
    <Compile Include="Options\ShaderOptions.cs">
      <SubType>Component</SubType>
    </Compile>
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Services\BackgroundWork.cs" />
    <Compile Include="Services\ShaderOutput.cs" />
    <Compile Include="Services\WorkspaceContext.cs" />
    <Compile Include="Services\WorkspaceMonitor.cs" />
    <Compile Include="ToolWindows\ShaderToolsControl.cs" />
    <Compile Include="ToolWindows\ShaderToolsWindow.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Design" />
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xaml" />
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.14.2142" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.Telemetry" Version="17.14.18" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VisualStudio.Utilities" Version="17.14.40264" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VisualStudio.LanguageServer.Client" Version="17.14.60" ExcludeAssets="runtime" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" ExcludeAssets="runtime" GeneratePathProperty="true" />
    <PackageReference Include="System.Memory" Version="4.6.3" ExcludeAssets="runtime" />
    <PackageReference Include="System.Collections.Immutable" Version="10.0.8" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ShaderTools.Core\ShaderTools.Core.csproj">
      <Name>ShaderTools.Core</Name>
      <IncludeOutputGroupsInVSIX>BuiltProjectOutputGroup</IncludeOutputGroupsInVSIX>
    </ProjectReference>
    <ProjectReference Include="..\ShaderTools.Bridge\ShaderTools.Bridge.csproj">
      <Name>ShaderTools.Bridge</Name>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <IncludeOutputGroupsInVSIX>BuiltProjectOutputGroup;BuiltProjectOutputGroupDependencies</IncludeOutputGroupsInVSIX>
      <VSIXSubPath>Bridge</VSIXSubPath>
    </ProjectReference>
    <Content Include="Grammars\**\*;Server\**\*;ShaderTools.pkgdef">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\assets\logo.png">
      <Link>assets\logo.png</Link>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="$(PkgNewtonsoft_Json)\lib\net45\Newtonsoft.Json.dll">
      <Link>Bridge\Newtonsoft.Json.dll</Link>
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\licenses\**\*;..\THIRD-PARTY-NOTICES.md">
      <Link>licenses\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <VSCTCompile Include="Commands.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets" Condition="'$(VSToolsPath)' != ''" />
  <!-- VSSDK can reuse a detokenized manifest after metadata-only changes.
       Invalidate that generated file when the source manifest is newer. -->
  <Target Name="RefreshChangedVsixManifest" BeforeTargets="DetokenizeVsixManifestFile"
          Inputs="source.extension.vsixmanifest" Outputs="$(IntermediateVsixManifest)"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Delete Files="$(IntermediateVsixManifest)" />
  </Target>
  <Target Name="VerifyShaderServer" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('Server\shader-language-server.exe') Or !Exists('Server\dxcompiler.dll') Or !Exists('Server\dxil.dll')" Text="Run scripts\acquire-server.ps1 before building: the pinned shader server bundle is missing." />
  </Target>
</Project>
